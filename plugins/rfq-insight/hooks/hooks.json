{
  "description": "Approve the RFQ Insight skill's own scripts and checkpoint writes so a run does not stop for a permission prompt at every stage.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
