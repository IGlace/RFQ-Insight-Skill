{
  "description": "Approve the RFQ Insight skill's own scripts and checkpoint writes so a run does not stop for a permission prompt at every stage. Claude pre-approves through PreToolUse; Codex approves sandbox escalations through PermissionRequest.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/approve.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
